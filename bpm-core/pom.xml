<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.16 是 3.5 線最後一個 OSS 版本（2026-06-25）；3.5 已於 2026-06-30 結束 OSS 支援。
             升級路徑見 docs/plan/2026-09-28-springboot4-upgrade.md（不要直接跳 4.x，Flowable 需經 7.x 中繼）。 -->
        <version>3.5.16</version>
    </parent>
    <groupId>com.bpm</groupId>
    <artifactId>bpm-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bpm-core</name>

    <properties>
        <java.version>21</java.version>
        <!-- Stage 4（docs/plan/2026-09-28-springboot4-upgrade.md）：
             6.8.1 → 7.2.x，Spring Boot 版本刻意不動（留在 3.5.16）。
             單獨變更 Flowable 主版本，出問題就能確定來源是 Flowable 而非 Boot。
             ⚠️ 不要在這裡直接跳 8.x —— Flowable 8 不支援 Boot 3。 -->
        <flowable.version>7.2.0</flowable.version>
        <!-- springdoc-openapi（#65）。2.x 是給 Spring Boot 3 的線，3.x 給 Boot 4 ——
             不要跟著 Maven Central 的 latest 往上跳。
             2.9.1 的 parent POM 就是 spring-boot-starter-parent 3.5.16（與本專案相同），
             是 2.x 線最後一個穩定版；官方相容矩陣把 3.5.x 對到 2.8.x，但 2.8.17
             的建置基準是 3.5.13，2.9.1 反而更貼合目前版本。
             ⚠️ 升級 Boot 3.5.x 時要一起確認這裡。 -->
        <springdoc.version>2.9.1</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- API 文件（#65）。dev/test 開放 /swagger-ui.html 與 /v3/api-docs；
             prod 由 application.yml 的 prod 文件把 api-docs 與 swagger-ui 設為
             enabled: false（那時端點根本不會註冊）。SecurityConfig 對這些路徑的
             permitAll 只是讓 dev/test 進得去，兩層的關係寫在該處的註解。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 認證與授權（security-audit：平台層原本完全沒有 Spring Security，
             身分靠呼叫端自帶的 X-User-Id 標頭，可隨意填寫）。

             oauth2-resource-server 提供 JWT 驗證：應用只驗簽章與 claims，
             永不經手密碼。dev 用本地產生的 RSA 金鑰自行簽發，
             prod 由企業 IdP 的 issuer-uri 提供 JWKS。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- nimbus-jose-jwt（dev 簽發 token 用）不需要顯式宣告：
             它由 oauth2-resource-server → spring-security-oauth2-jose
             遞移帶入，且不在 Boot 的 BOM 管理範圍內，
             寫死版本反而會與 Spring Security 期望的版本漂移。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-bpmn-layout</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <!-- Flyway 接手應用表的 schema（Flowable 的 ACT_*／FLW_* 仍由 flowable.database-schema-update 管理）。
             flyway-sqlserver 是 MSSQL 的方言模組，缺了它 flyway-core 無法處理 SQL Server。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 整合測試以 Testcontainers 起真實 MSSQL／RabbitMQ／Redis。
             不用 H2：MSSQL 的 datetimeoffset、NVARCHAR(MAX)、MERGE 與識別欄位行為都無法在 H2 上重現，
             而稽核 hash chain 與表單版本鎖定正是依賴這些行為。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mssqlserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

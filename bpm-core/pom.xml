<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Stage 5（docs/plan/2026-09-28-springboot4-upgrade.md）：3.5.16 → 4.1.1（S5-0e）。
             3.5 線已於 2026-06-30 結束 OSS 支援，4.1.1 是目前 4.x 最新。
             ⚠️ 這次必須與 Flowable 8.0.0 同步跳：Flowable 7 不支援 Boot 4、
             Flowable 8 不支援 Boot 3，沒有中繼點。 -->
        <version>4.1.1</version>
    </parent>
    <groupId>com.bpm</groupId>
    <artifactId>bpm-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bpm-core</name>

    <properties>
        <java.version>21</java.version>
        <!-- Stage 5（docs/plan/2026-09-28-springboot4-upgrade.md）：
             7.2.0 → 8.0.0，與 Spring Boot 4.1.1 同步跳。
             Flowable 8 是唯一支援 Boot 4 的線（8.0.0 也是 8.x 唯一版本，2026-02-27 發布後無 patch）；
             反向也成立：Flowable 7.2.0 在 Boot 4 上無法運作。兩者之間沒有中繼點，
             這也是 Stage 4 先把 Flowable 單獨升到 7.2.0（留在 Boot 3.5.16）的原因。
             ⚠️ 升級後 `flowable.variable-json-mapper: jackson2` 必須保留（見 application.yml）；
             Flowable 8 預設 Jackson 3，而本專案 Java 程式碼仍在 Jackson 2，Stage 6 才遷移。 -->
        <flowable.version>8.0.0</flowable.version>
        <!-- springdoc-openapi（#65）。2.x 是給 Spring Boot 3 的線，3.x 給 Boot 4（S5-0e）。
             3.1.1 是 3.x 最新版，其 parent POM 就是 spring-boot-starter-parent 4.1.0，
             與本專案的 4.1.1 同線。 -->
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Stage 5（S5-0e）：補回 Jackson 2 的自動配置。Boot 4 預設自動配置 Jackson 3 的
             JsonMapper，而本專案 5 個類別（WebhookConsumer／AuditEventPublisher／
             AuditEventConsumer／ExternalApiAuthFilter／ExternalSystemPolicy）仍以建構式注入
             Jackson 2 的 com.fasterxml.jackson.databind.ObjectMapper —— 少了這個模組，
             Stage 5 啟動就會失敗（前置調查結論 ①）。
             ⚠️ 這是「補回 Jackson 2 依賴」，不是 Jackson 3 遷移；Stage 6 才移除。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- API 文件（#65）。dev/test 開放 /swagger-ui.html 與 /v3/api-docs；
             prod 由 application.yml 的 prod 文件把 api-docs 與 swagger-ui 設為
             enabled: false（那時端點根本不會註冊）。SecurityConfig 對這些路徑的
             permitAll 只是讓 dev/test 進得去，兩層的關係寫在該處的註解。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 認證與授權（security-audit：平台層原本完全沒有 Spring Security，
             身分靠呼叫端自帶的 X-User-Id 標頭，可隨意填寫）。

             oauth2-resource-server 提供 JWT 驗證：應用只驗簽章與 claims，
             永不經手密碼。dev 用本地產生的 RSA 金鑰自行簽發，
             prod 由企業 IdP 的 issuer-uri 提供 JWKS。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- nimbus-jose-jwt（dev 簽發 token 用）不需要顯式宣告：
             它由 oauth2-resource-server → spring-security-oauth2-jose
             遞移帶入，且不在 Boot 的 BOM 管理範圍內，
             寫死版本反而會與 Spring Security 期望的版本漂移。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-bpmn-layout</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <!-- Flyway 接手應用表的 schema（Flowable 的 ACT_*／FLW_* 仍由 flowable.database-schema-update 管理）。
             Boot 4 起 Flyway 自動配置移入 spring-boot-starter-flyway（S5-0e），
             不再直接宣告 flyway-core —— starter 會遞移帶入 flyway-core（Boot 4.1.1 管理 12.4.0）。
             flyway-sqlserver 是 MSSQL 的方言模組，缺了它 flyway-core 無法處理 SQL Server。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Stage 5（S5-0c）：Boot 4 屬性遷移輔助已於驗收後移除（2026-10-03）。
             保留這行註解是為了讓下一個人知道它曾經在場、以及為什麼不在了：
             它是遷移工具，不是正式依賴（移除後啟動與完整套件均已重驗）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 把 MockMvc 測試支援拆到 spring-boot-webmvc-test（S5 Java 修復）。
             @AutoConfigureMockMvc 與 MockMvcBuilderCustomizer 的新套件是
             org.springframework.boot.webmvc.test.autoconfigure；少了這個 starter，
             testCompile 會直接找不到套件（已由編譯錯誤證明，非預防性宣告）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 整合測試以 Testcontainers 起真實 MSSQL／RabbitMQ／Redis。
             不用 H2：MSSQL 的 datetimeoffset、NVARCHAR(MAX)、MERGE 與識別欄位行為都無法在 H2 上重現，
             而稽核 hash chain 與表單版本鎖定正是依賴這些行為。
             ⚠️ Boot 4.1.1 管理 Testcontainers 2.0.5（3.5 是 1.21.4），2.0 把模組更名為
             testcontainers-<module>；舊 artifactId（junit-jupiter／mssqlserver／rabbitmq）
             在 BOM 裡已不存在，留著會讓 Maven 讀 POM 時就報 version missing。
             這裡只改座標、不調版本（版本由 Boot 4.1.1 管理）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mssqlserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

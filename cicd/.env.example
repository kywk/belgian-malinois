# Production environment variables
# Copy to .env and fill in actual values

MSSQL_SA_PASSWORD=ChangeMe_Strong_Password!
RABBITMQ_USER=bpm_prod
RABBITMQ_PASS=ChangeMe_RabbitMQ!
REDIS_PASSWORD=ChangeMe_Redis!
WEBHOOK_HMAC_SECRET=ChangeMe_HMAC_Secret!
# API key v2 雜湊的 HMAC secret（R-25）。至少 32 bytes；未設定即啟動失敗。
API_KEY_HMAC_SECRET=ChangeMe_ApiKey_HMAC_Secret_At_Least_32_Bytes!
GITHUB_REPO=your-org/greyhound
IMAGE_TAG=latest
